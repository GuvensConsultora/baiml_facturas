<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_no_tax_col"
              inherit_id="l10n_ar.report_invoice_document"
              name="BAIML — Ocultar columna Impuestos en PDF">

        <!-- Header tax column: l10n_ar usa t-if="not _l10n_ar_include_vat()" -->
        <xpath expr="//th[@name='th_taxes']" position="replace"/>

        <!-- Celda de impuestos en líneas individuales: reemplazar por nodo vacío -->
        <xpath expr="//td[@name='td_taxes']" position="replace">
            <td name="td_taxes" t-if="False"/>
        </xpath>

        <!-- Celda de impuestos en líneas agrupadas: reemplazar por nodo vacío -->
        <xpath expr="//td[@name='td_taxes_grouped']" position="replace">
            <td name="td_taxes_grouped" t-if="False"/>
        </xpath>

    </template>
</odoo>
