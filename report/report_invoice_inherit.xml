<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_no_tax_col"
              inherit_id="l10n_ar.report_invoice_document"
              name="BAIML — Ajustes PDF facturas">

        <!-- Encabezado: mostrar logo/razón social/CUIT en borradores y en facturas
             electrónicas con CAE aunque el journal sea II_IM (pre-impreso).
             Solo se oculta cuando la factura está posted SIN auth_code_due en II_IM
             (único caso donde el papel realmente viene pre-impreso). -->
        <xpath expr="//t[@t-set='pre_printed_report']" position="attributes">
            <attribute name="t-value">report_type == 'pdf' and o.journal_id.l10n_ar_afip_pos_system == 'II_IM' and o.state == 'posted' and not o.l10n_ar_afip_auth_code_due</attribute>
        </xpath>

        <!-- Columna Descuento: ocultar apagando el flag nativo display_discount.
             Oculta el th, las celdas (línea/agrupado) y ajusta los colspan de
             las secciones de una. El descuento sigue reflejado en el Importe. -->
        <xpath expr="//t[@t-set='display_discount']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>

        <!-- Columna impuestos: ocultar header th y celdas de datos -->
        <xpath expr="//th[@name='th_taxes']" position="replace"/>

        <xpath expr="//td[@name='td_taxes']" position="replace">
            <td name="td_taxes" t-if="False"/>
        </xpath>

        <xpath expr="//td[@name='td_taxes_grouped']" position="replace">
            <td name="td_taxes_grouped" t-if="False"/>
        </xpath>

    </template>
</odoo>
