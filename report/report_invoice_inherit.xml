<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_no_tax_col"
              inherit_id="l10n_ar.report_invoice_document"
              name="BAIML — Ocultar columna Impuestos en PDF">

        <!-- Header: l10n_ar usa t-if="not _l10n_ar_include_vat()" → eliminar -->
        <xpath expr="//th[@name='th_taxes']" position="replace"/>

        <!-- Celda de impuestos en líneas individuales:
             l10n_ar cambió el t-if a "not hide_prices and not _l10n_ar_include_vat()"
             → forzar False para que nunca renderice -->
        <xpath expr="//span[@id='line_tax_ids']/.." position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- Celda de impuestos en líneas agrupadas: mismo patrón -->
        <xpath expr="//span[@id='grouped_line_tax_ids']/.." position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

    </template>
</odoo>
