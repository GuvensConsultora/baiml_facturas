<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_bonif_desc" model="ir.ui.view">
        <field name="name">sale.order.bonif.desc.baiml</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="after">
                <group string="Ajustes de precio">
                    <field name="bonif_percent" string="Bonificación %"/>
                    <field name="discount_percent" string="Descuento %"/>
                </group>
                <div class="mb-3"
                     invisible="(not bonif_percent and not discount_percent) or state not in ['draft', 'sent']">
                    <button name="action_recalcular_ajustes"
                            string="Recalcular ajustes"
                            type="object"
                            class="btn btn-secondary btn-sm"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
