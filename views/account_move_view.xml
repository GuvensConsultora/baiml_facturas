<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_bonif_desc" model="ir.ui.view">
        <field name="name">account.move.bonif.desc.baiml</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Agrega bonif% y desc% después de las líneas de factura -->
            <xpath expr="//field[@name='invoice_line_ids']" position="after">
                <group invisible="move_type not in ['out_invoice', 'out_refund']">
                    <field name="bonif_percent" string="Bonificación %"/>
                    <field name="discount_percent" string="Descuento %"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
