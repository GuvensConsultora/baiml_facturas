<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_bonif_desc" model="ir.ui.view">
        <field name="name">account.move.bonif.desc.baiml</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Agrega bonif% y desc% en el área de totales, antes del bloque de impuestos -->
            <xpath expr="//div[hasclass('oe_subtotal_footer')]" position="before">
                <div class="o_td_label" groups="base.group_user"
                     attrs="{'invisible': [('move_type', 'not in', ['out_invoice','out_refund'])]}">
                    <label for="bonif_percent" string="Bonificación %"/>
                    <field name="bonif_percent" class="oe_inline"/>
                    <label for="discount_percent" string="Descuento %"/>
                    <field name="discount_percent" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
